---
import { FOOTER_COLUMNS, RELATED_TOOLS, SITE, storeUrl } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const storeLink = storeUrl('footer');
---

<footer id="site-footer" class="border-t border-slate-200 bg-slate-50">
  <div class="container-page py-14 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="max-w-sm lg:col-span-4">
        <a href="/" class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
          <img
            src="/images/brand/bvt-icon-48.png"
            width="32"
            height="32"
            alt=""
            class="h-8 w-8 rounded-lg"
          />
          <span class="text-lg font-bold tracking-tight text-slate-950">{SITE.name}</span>
        </a>
        <p class="mt-4 text-sm leading-6 text-slate-600">
          An independent Chrome extension for single and bulk TikTok video downloads,
          short drama episodes, and XLSX metadata export.
        </p>
        <a
          href={storeLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800"
        >
          Add BVT to Chrome
          <Icon name="external" class="h-3.5 w-3.5" />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>

      {
        FOOTER_COLUMNS.map((column) => (
          <div class="lg:col-span-2">
            <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
              {column.title}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-slate-600 transition-colors hover:text-brand-700"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-slate-200 pt-6">
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
        More TikTok tools
      </h2>
      {
        RELATED_TOOLS.map((tool) => (
          <a
            href={tool.href}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 text-sm text-slate-600 transition-colors hover:text-brand-700"
          >
            <span>{tool.name}</span>
            <Icon name="external" class="h-3.5 w-3.5 shrink-0" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        ))
      }
    </div>

    <div class="mt-8 border-t border-slate-200 pt-8">
      <p class="max-w-4xl text-xs leading-6 text-slate-500">
        {SITE.name} is an independent browser extension and is not affiliated with,
        endorsed by, or sponsored by TikTok or ByteDance. TikTok and related marks are
        trademarks of their respective owners. Download only content you have the rights
        to use.
      </p>
      <div
        class="mt-4 flex flex-col justify-between gap-2 text-xs text-slate-500 sm:flex-row sm:items-center"
      >
        <p>© {year} {SITE.name}. All rights reserved.</p>
        <p>Built for public TikTok pages you have opened and loaded.</p>
      </div>
    </div>
  </div>
</footer>
