---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import InstallButton from '../components/InstallButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPPORT_FAQS } from '../data/faqs';
import { SUPPORTED_PAGES, SITE } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const title = 'Support & Troubleshooting — BVT';
const description =
  'Installation, supported pages, download troubleshooting, Pro activation, and answers to common BVT questions.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Support', href: '/support/' },
  ]),
  faqSchema(SUPPORT_FAQS),
];

const troubleshooting = [
  [
    'The download button does not appear',
    'Confirm BVT is enabled, open a supported public tiktok.com page, and refresh. Private or logged-in-only content is outside the supported scope.',
  ],
  [
    'No videos are listed in a batch',
    'Scroll or load more on the page, confirm the page type, and try again. A login wall, region block, or a page with no rendered cards can leave the list empty.',
  ],
  [
    'A download stays at 0% or fails',
    'Media URLs can expire, the network can drop, or the video may have no playable source. Refresh the page and retry. In a batch, failures are reported without stopping the rest.',
  ],
  [
    'ZIP or folder saving does not start',
    'Folder saving uses the browser’s File System Access API. Start the action again, choose a folder, and approve the permission prompt. A dismissed prompt cancels the run.',
  ],
  [
    'The XLSX file is empty',
    'Confirm that videos are selected before exporting. A selection can be cleared by a page change. Re-select the records and export again.',
  ],
  [
    'Pro is active but BVT still says Basic',
    'Return to the extension after checkout and refresh the license status. Confirm you are in the same Chrome profile. If it still fails, contact support with the purchase reference only.',
  ],
  [
    'Short drama episodes are missing',
    'Episodes can be region-restricted, removed, or unavailable from the page. BVT cannot load or download episodes TikTok does not expose.',
  ],
  [
    'BVT stopped working after a TikTok update',
    'TikTok changes its page layout periodically. Check for an extension update, refresh the page, and contact support if the issue persists.',
  ],
];
---

<BaseLayout title={title} description={description} canonicalPath="/support/" jsonLd={jsonLd}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Support', href: '/support/' },
        ]}
      />
      <div class="mt-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          Support
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Support &amp; Troubleshooting
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Installation, supported pages, download failures, and Pro activation. BVT is
          intentionally scoped to public pages you can open without an account.
        </p>
        <div class="mt-7">
          <InstallButton campaign="support" label="Open the Chrome Web Store" />
        </div>
      </div>
    </div>
  </section>

  <div class="container-page grid gap-12 py-12 sm:py-16 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div class="min-w-0">
      <section>
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Install and open the extension</h2>
        <ol class="mt-5 space-y-4">
          {[
            ['Install BVT from the Chrome Web Store', 'Open the BVT listing and choose Add to Chrome. Pin the extension if you want quick access.'],
            ['Open a supported public page', 'Use a public TikTok video, profile, Search, Explore, hashtag, short drama, or Home page.'],
            ['Use the download control', 'The extension adds controls to supported page elements. If you do not see one, refresh the page.'],
            ['Choose the workflow', 'Download a single video, add items to a batch, or open the creator or short drama panel.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Supported public pages</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          BVT works with content TikTok makes available on the public page you open.
          Supported page types:
        </p>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2">
          {SUPPORTED_PAGES.map((page) => (
            <li class="flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
              <Icon name="check" class="h-4 w-4 shrink-0 text-brand-600" />
              {page}
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs leading-5 text-slate-500">
          BVT does not bypass login, CAPTCHA, region blocks, DRM, or rate limits. TikTok
          may still show a login wall for some public content, and BVT cannot override it.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Troubleshooting</h2>
        <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200">
          <table class="w-full border-collapse text-left text-sm">
            <caption class="sr-only">Common BVT problems and checks</caption>
            <thead class="bg-slate-50">
              <tr>
                <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">Symptom</th>
                <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">What to check</th>
              </tr>
            </thead>
            <tbody>
              {troubleshooting.map(([symptom, check]) => (
                <tr class="border-t border-slate-100 align-top">
                  <th scope="row" class="px-3 py-3 font-semibold text-slate-800 sm:px-5 sm:py-3.5">{symptom}</th>
                  <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-3.5">{check}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Pro and content rights</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-white p-5">
            <h3 class="text-sm font-bold text-slate-950">Pro activation</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Pro is an in-app purchase that unlocks the full batch workflow. The
              extension shows the current plan and price before checkout. BVT does not
              handle card details on this website.
            </p>
          </div>
          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <h3 class="text-sm font-bold text-slate-950">Only download what you have rights to use</h3>
            <p class="mt-2 text-sm leading-6 text-slate-700">
              Follow applicable law, TikTok’s terms, and the content owner’s permissions.
              BVT does not grant permission and does not bypass access controls or DRM.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">FAQ</h2>
        <div class="mt-5">
          <FAQ items={SUPPORT_FAQS} />
        </div>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight text-slate-950">Contact</h2>
        <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <div class="flex gap-3">
            <Icon name="mail" class="mt-0.5 h-5 w-5 shrink-0 text-brand-700" />
            <div>
              <p class="text-sm font-bold text-slate-950">Email support</p>
              <p class="mt-1.5 text-sm leading-6 text-slate-600">
                Write to{' '}
                <a
                  href={`mailto:${SITE.supportEmail}`}
                  class="font-semibold text-brand-700 hover:underline"
                >
                  {SITE.supportEmail}
                </a>
                {' '}for support or privacy questions. Include the extension version and
                page type. Do not send account credentials, page data, or subscription
                tokens.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>

    <aside class="space-y-5">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-bold text-slate-950">Quick links</h2>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/features/single-video-download/" class="text-slate-600 hover:text-brand-700">Single video download</a></li>
          <li><a href="/features/bulk-download/" class="text-slate-600 hover:text-brand-700">Bulk from lists</a></li>
          <li><a href="/features/creator-video-download/" class="text-slate-600 hover:text-brand-700">Creator tools</a></li>
          <li><a href="/features/short-drama-download/" class="text-slate-600 hover:text-brand-700">Short drama</a></li>
          <li><a href="/features/xlsx-export/" class="text-slate-600 hover:text-brand-700">XLSX export</a></li>
          <li><a href="/guides/" class="text-slate-600 hover:text-brand-700">Guides</a></li>
          <li><a href="/privacy/" class="text-slate-600 hover:text-brand-700">Privacy Policy</a></li>
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-sm font-bold text-slate-950">Version</h2>
        <p class="mt-2 text-sm text-slate-600">Current build: {SITE.version}</p>
        <p class="mt-2 text-xs leading-5 text-slate-500">
          The extension is listed on the Chrome Web Store as BVT: Batch Video Downloader
          for TikTok.
        </p>
      </div>
    </aside>
  </div>

  <CTA
    campaign="support-final"
    title="Still stuck? Start with the page type."
    description="Most download problems come from an unsupported page, an expired media URL, or a missing playable source. Refresh, confirm the page, and check the FAQ."
    secondaryHref="/guides/"
    secondaryLabel="Browse the guides"
  />
</BaseLayout>
