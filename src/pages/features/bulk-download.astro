---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import ProductShot from '../../components/ProductShot.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BULK_DOWNLOAD_FAQS } from '../../data/faqs';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Bulk Download TikTok Videos — BVT';
const description =
  'Batch download public TikTok videos from Search, Explore, hashtags, and creator profiles with BVT. Save a ZIP or write selected MP4 files to a folder.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Features', href: '/features/' },
    { name: 'Bulk Download', href: '/features/bulk-download/' },
  ]),
  faqSchema(BULK_DOWNLOAD_FAQS),
];

const limits = [
  'BVT only works with videos the page returns or renders. A list page is a sample, not a complete TikTok index.',
  'Basic has limited batch processing; Pro unlocks the full batch workflow. The extension shows current limits.',
  'A video can lack a playable source or expose an expired URL. Failed items are reported separately.',
  'BVT does not bypass login, CAPTCHA, region blocks, DRM, or rate limits.',
  'A ZIP is generated through the browser download flow; folder saving requires you to choose and authorize a folder.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/features/bulk-download/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Features', href: '/features/' },
          { name: 'Bulk Download', href: '/features/bulk-download/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Bulk downloads
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            Bulk Download TikTok Videos
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            Add videos from Search results, Explore, hashtags, or a creator profile, then
            save the selection as a ZIP or as individual MP4 files in a folder you choose.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton campaign="feature-bulk-download" label="Add BVT to Chrome" />
            <a
              href="/guides/how-to-bulk-download-tiktok-videos/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              Read the bulk download guide
            </a>
          </div>
        </div>
        <ProductShot id="search-list" priority />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['Add from supported lists', 'Use the add control on Search, Explore, hashtag, or creator cards. Select individual items or use the page-level controls.'],
          ['ZIP or folder output', 'A ZIP is one file through the browser download flow. Folder saving writes individual MP4 files to a location you choose.'],
          ['Progress and failures', 'Watch the batch progress and review failed items. A failed item does not stop the rest of the queue.'],
        ].map(([heading, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-base font-bold text-slate-950">{heading}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeading
          eyebrow="ZIP or folder"
          title="Choose the output that matches the batch."
          description="Both options use the same selected set. The difference is how the files reach your computer."
        />
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
              <Icon name="zip" class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Download a ZIP</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Best for a smaller batch you want to move as one archive. The ZIP is
              generated locally and saved through the browser.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm">
              <Icon name="folder" class="h-5 w-5" />
            </span>
            <h2 class="mt-4 text-base font-bold text-slate-950">Save to a folder</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Best for a larger batch or later review. The browser asks you to choose a
              folder and grant write access before files are written.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <SectionHeading
          eyebrow="Workflow"
          title="Build the selection, then start the batch."
          description="The selection is the source of truth for both download and export actions."
        />
        <ol class="space-y-4">
          {[
            ['Open a supported list page', 'Search results, Explore, a hashtag page, or a creator profile. Let the page load before adding items.'],
            ['Add the videos', 'Use the add control on each card, or the page-level selection controls where available.'],
            ['Review the count', 'Confirm the selected count before starting. A filter change should not silently change what you selected.'],
            ['Choose ZIP or folder', 'Start the batch and choose the output. For folder saves, approve the browser’s folder prompt.'],
            ['Check the failures', 'Review any failed items, refresh the page if a media URL expired, and retry the selection.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Limits" title="What a batch can and cannot cover." />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {limits.map((limit) => (
          <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0 text-signal-500" />
            <p>{limit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <div class="flex gap-4">
          <Icon name="alert" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
          <div>
            <h2 class="text-lg font-bold text-slate-950">A batch is not a license.</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-700">
              Downloading a public video does not give you the right to republish it, use
              it in an ad, or claim it as your own. Follow applicable law, TikTok’s terms,
              and the content owner’s permissions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="FAQ" title="Bulk download questions." align="center" />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={BULK_DOWNLOAD_FAQS} />
      </div>
    </div>
  </section>

  <CTA
    campaign="feature-bulk-final"
    title="Turn a page of videos into a folder."
    description="Install BVT, open a supported public list page, and batch download the selection. Pro unlocks the full batch workflow."
    secondaryHref="/guides/how-to-bulk-download-tiktok-videos/"
    secondaryLabel="Read the bulk download guide"
  />
</BaseLayout>
