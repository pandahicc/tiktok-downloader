---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import ProductShot from '../../components/ProductShot.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SINGLE_VIDEO_FAQS } from '../../data/faqs';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Download a Single TikTok Video — BVT';
const description =
  'Save a single public TikTok video with BVT. Download the watermark-free HD source where available, choose a filename template, and track progress.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Features', href: '/features/' },
    { name: 'Single Video Download', href: '/features/single-video-download/' },
  ]),
  faqSchema(SINGLE_VIDEO_FAQS),
];

const filenameTemplates = [
  ['title', 'The video description, cleaned up for a filename.'],
  ['date_title', 'Publish date followed by the video description.'],
  ['date_vid', 'Publish date followed by the video ID.'],
  ['username_date_title', 'Creator username, publish date, and description.'],
] as const;

const limits = [
  'Not every video exposes a playable source. A video without one cannot be downloaded.',
  'HD and watermark-free output depend on the source TikTok provides for that video.',
  'BVT does not re-encode media, so it cannot remove a watermark that is part of the only source.',
  'Private, removed, region-blocked, or login-only content is outside the supported scope.',
  'A media URL can expire. Refresh the page and retry if a download fails.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/features/single-video-download/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Features', href: '/features/' },
          { name: 'Single Video Download', href: '/features/single-video-download/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Single video
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            TikTok Single Video Downloader
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            Open a public TikTok video, use the BVT download control, and save the
            best source the page makes available. Choose a filename template once and
            reuse it for every download.
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-500">
            Watermark-free and HD output depend on the source TikTok provides. BVT does
            not edit or re-encode the file.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton campaign="feature-single-video" label="Add BVT to Chrome" />
            <a
              href="/guides/how-to-download-tiktok-videos/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              Read the single-video guide
            </a>
          </div>
        </div>
        <ProductShot id="single-download" priority />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['One control on the page', 'BVT adds a download control to supported public video pages and cards. No separate dashboard or upload step.'],
          ['Progress and cancel', 'A running download shows progress. Click the active control again to cancel the current request.'],
          ['Filename templates', 'Use a title, publish date, video ID, or username-based filename so the saved files stay recognizable.'],
        ].map(([heading, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-base font-bold text-slate-950">{heading}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <SectionHeading
          eyebrow="Quality"
          title="The best source the page actually exposes."
          description="BVT does not invent a higher quality version. It requests the clean HD source when TikTok provides one and falls back to what is available."
        />
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <ul class="space-y-3 text-sm leading-6 text-slate-600">
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />Watermark-free output where the page exposes a clean source.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />HD where the page provides an HD stream; SD otherwise.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />MP4 output, saved through the browser’s normal download flow.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />No re-encoding, filters, overlays, or audio extraction.</li>
          </ul>
          <p class="mt-5 rounded-xl bg-white p-4 text-xs leading-5 text-slate-500">
            Quality varies by video. A video can be public and still have no playable
            source, a lower-quality source, or a watermark that is part of the only file
            TikTok exposes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading
        eyebrow="Filename templates"
        title="Make the files easy to find later."
        description="Choose a naming pattern in the extension’s settings or popup before you start downloading."
      />
      <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">BVT filename template options</caption>
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">Template</th>
              <th scope="col" class="px-3 py-3 font-bold text-slate-900 sm:px-5 sm:py-3.5">What it uses</th>
            </tr>
          </thead>
          <tbody>
            {filenameTemplates.map(([name, description]) => (
              <tr class="border-t border-slate-100">
                <th scope="row" class="px-3 py-3 font-semibold text-slate-800 sm:px-5 sm:py-3.5">{name}</th>
                <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-3.5">{description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <SectionHeading
          eyebrow="Workflow"
          title="From the video page to a local file."
          description="A single download should not need a second application."
        />
        <ol class="space-y-4">
          {[
            ['Open a public video', 'Use a video detail page or a supported public feed. Let the page finish rendering.'],
            ['Click the BVT download control', 'The extension resolves the best available source and starts the download.'],
            ['Watch the progress', 'Keep the page open until the file is saved. Click the active control again to cancel.'],
            ['Find the file', 'The MP4 is saved through the browser’s download flow with the filename template you chose.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Limits" title="What to expect when a video will not download." />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {limits.map((limit) => (
          <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0 text-signal-500" />
            <p>{limit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <div class="flex gap-4">
          <Icon name="alert" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
          <div>
            <h2 class="text-lg font-bold text-slate-950">Only download content you have the rights to use.</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-700">
              Follow applicable law, TikTok’s terms, and the content owner’s permissions.
              BVT does not provide legal permission and does not bypass access controls,
              DRM, or other restrictions. Availability is not the same as authorization.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="FAQ" title="Single-video questions." align="center" />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={SINGLE_VIDEO_FAQS} />
      </div>
    </div>
  </section>

  <CTA
    campaign="feature-single-video-final"
    title="Save the next video you open."
    description="Install BVT and use the download control on a public TikTok video. Core features are free; Pro unlocks the full batch workflow."
    secondaryHref="/guides/how-to-download-tiktok-videos/"
    secondaryLabel="Read the single-video guide"
  />
</BaseLayout>
