---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import InstallButton from '../../components/InstallButton.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHORT_DRAMA_FAQS } from '../../data/faqs';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Download TikTok Short Drama Episodes — BVT';
const description =
  'Download selected episodes from a public TikTok short drama with BVT. Pick episodes from a paged grid, save them to a folder, or export their metadata to XLSX.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Features', href: '/features/' },
    { name: 'Short Drama Download', href: '/features/short-drama-download/' },
  ]),
  faqSchema(SHORT_DRAMA_FAQS),
];

const limits = [
  'BVT can only load episodes that the public short drama page makes available.',
  'Region restrictions, removals, or TikTok changes can leave episodes unavailable.',
  'BVT does not bypass access controls, DRM, or paywalls.',
  'A selected episode still needs a playable media source before it can be saved.',
  'Basic has limited batch processing; Pro unlocks the full batch workflow.',
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/features/short-drama-download/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Features', href: '/features/' },
          { name: 'Short Drama Download', href: '/features/short-drama-download/' },
        ]}
      />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
            Short drama
          </p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
            Download TikTok Short Drama Episodes
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
            Open a public short drama, browse the episode grid, select the episodes you
            need, and save them in one run. The same selection can be exported to XLSX.
          </p>
          <div class="mt-7 flex flex-col items-start gap-3 sm:flex-row sm:items-center">
            <InstallButton campaign="feature-short-drama" label="Add BVT to Chrome" />
            <a
              href="/guides/how-to-download-tiktok-short-dramas/"
              class="text-sm font-semibold text-brand-700 hover:underline"
            >
              Read the short drama guide
            </a>
          </div>
        </div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
            Episode picker
          </p>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />
              A paged grid of the available episodes.
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />
              Individual selection and a select-all control.
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />
              A visible selected count before you save or export.
            </li>
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />
              Folder write progress with success and failure counts.
            </li>
          </ul>
          <p class="mt-5 rounded-xl bg-slate-50 p-4 text-xs leading-5 text-slate-500">
            The current BVT Chrome Web Store listing does not include a short drama
            screenshot. This panel describes the picker rather than showing a mocked UI.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-5 md:grid-cols-3">
        {[
          ['A paged episode grid', 'The download control opens a modal with the available episodes. Browse the pages and click an episode to select or deselect it.'],
          ['Select all or some', 'Use the select-all control for the full episode list, or build a smaller set for a specific review.'],
          ['Save or export', 'Write the selected episodes to a folder, or export their metadata to an XLSX workbook.'],
        ].map(([heading, text]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-base font-bold text-slate-950">{heading}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <SectionHeading
          eyebrow="Workflow"
          title="Open the drama, choose episodes, save the set."
          description="The episode list is the selection scope. A failed episode does not stop the rest of the run."
        />
        <ol class="space-y-4">
          {[
            ['Open a public short drama', 'Use the supported TikTok short drama page and let the page finish rendering.'],
            ['Open the BVT download panel', 'The extension loads the available episodes into a paged grid.'],
            ['Select the episodes', 'Click episodes to toggle selection. Use the select-all control if you need the full list.'],
            ['Save to a folder', 'Choose a destination folder and approve the browser’s write permission.'],
            ['Or export the metadata', 'Select the episodes and export their public metadata to XLSX for review.'],
          ].map(([step, text], index) => (
            <li class="flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {index + 1}
              </span>
              <div>
                <h3 class="text-sm font-bold text-slate-950">{step}</h3>
                <p class="mt-1.5 text-sm leading-6 text-slate-600">{text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <SectionHeading
            eyebrow="Episode selection"
            title="A smaller set is often the better set."
            description="You do not have to download the whole drama. Select the episodes you are reviewing and leave the rest."
          />
          <ul class="mt-6 space-y-3 text-sm leading-6 text-slate-600">
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />The selected count is shown next to the save and export actions.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />Selections follow the episode list for the current drama.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />The folder workflow reports success and failure counts.</li>
            <li class="flex gap-3"><Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-brand-600" />The XLSX export uses the same selected episodes.</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6">
          <h2 class="text-base font-bold text-slate-950">Good to know</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            A short drama can be public while some episodes are not available in your
            region or no longer exposed by the page. BVT cannot create a missing episode
            or a playable source where TikTok does not provide one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="Limits" title="What short drama downloads cannot do." />
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {limits.map((limit) => (
          <div class="flex gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600">
            <Icon name="alert" class="mt-0.5 h-4 w-4 shrink-0 text-signal-500" />
            <p>{limit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-14 sm:py-20">
    <div class="container-page">
      <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
        <div class="flex gap-4">
          <Icon name="alert" class="mt-0.5 h-6 w-6 shrink-0 text-amber-600" />
          <div>
            <h2 class="text-lg font-bold text-slate-950">Short dramas are still someone’s work.</h2>
            <p class="mt-2 max-w-3xl text-sm leading-7 text-slate-700">
              Do not redistribute, monetize, or republish episodes without the rights
              holder’s permission. BVT is a download tool, not a license.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-14 sm:py-20">
    <div class="container-page">
      <SectionHeading eyebrow="FAQ" title="Short drama questions." align="center" />
      <div class="mx-auto mt-8 max-w-4xl">
        <FAQ items={SHORT_DRAMA_FAQS} />
      </div>
    </div>
  </section>

  <CTA
    campaign="feature-short-drama-final"
    title="Pick the episodes you need."
    description="Install BVT, open a public short drama, and build an episode selection. Pro unlocks the full batch workflow."
    secondaryHref="/guides/how-to-download-tiktok-short-dramas/"
    secondaryLabel="Read the short drama guide"
  />
</BaseLayout>
