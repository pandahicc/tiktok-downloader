---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../data/site';

const title = `Changelog — BVT v${SITE.version}`;
const description =
  'The current BVT public build: single video downloads, batch workflows, creator tools, short drama episodes, XLSX export, and interface details.';
const jsonLd = [
  breadcrumbSchema([
    { name: 'Home', href: '/' },
    { name: 'Changelog', href: '/changelog/' },
  ]),
];

const groups = [
  {
    title: 'Single downloads',
    items: [
      'Download control on supported public video pages and cards.',
      'Watermark-free source where TikTok exposes one; HD where an HD source is available.',
      'Filename templates: title, date + title, date + video ID, and username + date + title.',
      'Progress reporting and the ability to cancel the current download.',
    ],
  },
  {
    title: 'Batch and creator workflows',
    items: [
      'Add videos from Search, Explore, hashtags, and creator profiles.',
      'Download the selection as a ZIP or write it to a folder you choose.',
      'Creator channels for posts, reposts, playlists, and liked videos.',
      'Duration, time, keyword, and count filters over the loaded list.',
      'Basic and Pro plan boundaries shown in the extension.',
    ],
  },
  {
    title: 'Short dramas',
    items: [
      'Download control on supported public short drama pages.',
      'Paged episode grid with individual selection and select-all.',
      'Save selected episodes to a folder.',
      'Export selected episode metadata to XLSX.',
    ],
  },
  {
    title: 'XLSX export',
    items: [
      'One row per selected video, with the fields the page exposes.',
      'Video ID, cover, description, detail URL, media URL, isTop, create date, playlist ID, playlist name, duration, and engagement counts.',
      'Local workbook generation; no spreadsheet service connection.',
      'Missing values are left blank rather than estimated.',
    ],
  },
  {
    title: 'Interface and privacy',
    items: [
      '23 interface languages, following the browser UI language.',
      'Local page processing; page data is not uploaded to BVT servers.',
      'No analytics or telemetry in the extension.',
      'Pro license validation is a separate, narrowly scoped request.',
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/changelog/"
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container-page py-10 sm:py-14">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Changelog', href: '/changelog/' },
        ]}
      />
      <div class="mt-8 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-600">
          Changelog
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">
          Changelog
        </h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          What is in the current public build. This page records capabilities, not a
          version-by-version diff, and it will be updated as new releases ship.
        </p>
      </div>
    </div>
  </section>

  <div class="container-page py-12 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <aside>
        <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">
            Current build
          </p>
          <p class="mt-2 text-3xl font-bold tracking-tight text-slate-950">
            v{SITE.version}
          </p>
          <p class="mt-1 text-sm text-slate-500">November 2026</p>
          <p class="mt-4 text-xs leading-5 text-slate-500">
            The Chrome Web Store listing is the source of truth for the current public
            build and plan details. This entry describes the capabilities this site
            references rather than claiming a complete version history.
          </p>
        </div>
      </aside>

      <div>
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-emerald-700">
              Current
            </span>
            <h2 class="text-2xl font-bold tracking-tight text-slate-950">
              Version {SITE.version}
            </h2>
            <span class="text-sm text-slate-500">November 2026</span>
          </div>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
            The current build includes single video downloads, list and profile batch
            workflows, short drama episode selection, ZIP or folder output, and XLSX
            metadata export. Feature availability still depends on what a public page
            exposes.
          </p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {groups.map((group) => (
              <section class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <h3 class="text-sm font-bold uppercase tracking-[0.1em] text-brand-700">
                  {group.title}
                </h3>
                <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                  {group.items.map((item) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-brand-600" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-slate-700">
            <div class="flex gap-3">
              <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" />
              <div>
                <p class="font-semibold text-slate-900">Not in this build</p>
                <p class="mt-1">
                  A complete creator archive, cross-page merging, historical snapshots,
                  sales or revenue estimates, audience demographics, an audio-only
                  download, a server-side download service, and an Excel or Google Sheets
                  integration are not part of this build. They should not be treated as
                  current features.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <CTA
    campaign="changelog-final"
    title="Install the current build."
    description="Start with a single download. Pro unlocks the full batch workflow when you need it."
    secondaryHref="/features/"
    secondaryLabel="Explore the features"
  />
</BaseLayout>
